{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JTGD",
  "version": "1.0.5",
  "identifier": "com.njs98.jtgd",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "高德车机版一键修复",
        "width": 860,
        "height": 720,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
